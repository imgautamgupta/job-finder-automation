# Application Environment (development, production)
APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths (relative to project root or absolute paths)
DATABASE_PATH=data/jobs.db
EXPORTS_DIR=data/exports
LOGS_DIR=data/logs
BACKUPS_DIR=data/backups
PROFILE_PATH=data/profile.json

# Backup Retention (Days to retain timestamped backups in data/backups)
DATABASE_BACKUP_RETENTION_DAYS=30

# Optional: Path to resume file (.pdf, .docx, .txt, .md) or folder with resume versions.
# If left empty, uses data/profile.json as the fallback candidate profile.
RESUME_PATH=

# Collector Configuration
MAX_RESULTS_PER_SOURCE=25
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

# Daily Schedule Time (for reference / Windows Task Scheduler)
DAILY_RUN_TIME=08:00

# Naukri Collector Limits & Delays
NAUKRI_ENABLED=true
NAUKRI_MAX_PAGES=1
NAUKRI_MAX_JOBS=10
NAUKRI_REQUEST_DELAY_SEC=2.0

# Lever Public Job Source Configuration
LEVER_ENABLED=false
LEVER_COMPANIES=paytm,meesho,jumpcloud,fampay,epifi
LEVER_MAX_JOBS_PER_COMPANY=25
LEVER_REQUEST_DELAY_SEC=1.0

# Greenhouse Public Job Board Configuration
GREENHOUSE_ENABLED=false
GREENHOUSE_COMPANIES=stripe,rubrik,mongodb,gitlab,elastic,instawork,glance,hackerrank,samsara,twilio
GREENHOUSE_MAX_JOBS_PER_COMPANY=25
GREENHOUSE_REQUEST_DELAY_SEC=1.0
