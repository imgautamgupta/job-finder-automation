# Application Environment (development, production)
APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths (relative to project root or absolute paths)
DATABASE_PATH=data/jobs.db
EXPORTS_DIR=data/exports
LOGS_DIR=data/logs
BACKUPS_DIR=data/backups
PROFILE_PATH=data/profile.json

# Backup Retention (Days to retain timestamped backups in data/backups)
DATABASE_BACKUP_RETENTION_DAYS=30

# Optional: Path to resume file (.pdf, .docx, .txt, .md) or folder with resume versions.
# If left empty, uses data/profile.json as the fallback candidate profile.
RESUME_PATH=

# Collector Configuration
MAX_RESULTS_PER_SOURCE=50
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

# Experience Double Filter Configuration
MAX_REQUIRED_MIN_YEARS=1

# Daily Schedule Time (for reference / Windows Task Scheduler)
DAILY_RUN_TIME=08:00

# ---- ACCENTURE-ONLY MODE (default intended setup) ----
# The pipeline is configured to collect jobs exclusively from the Accenture
# Careers portal (https://www.accenture.com/in-en/careers/jobsearch).
# All other job-source connectors are disabled by default but can be
# re-enabled individually by setting the corresponding _ENABLED flag to true.

# Accenture Careers Portal Configuration (ENABLED)
ACCENTURE_ENABLED=true
ACCENTURE_MAX_JOBS=100
ACCENTURE_REQUEST_DELAY_SEC=1.5
ACCENTURE_COUNTRY=India
ACCENTURE_COUNTRY_SITE=in-en
# Optional: comma-separated search keywords that override profile.json target_roles.
# Leave empty to derive queries automatically from your profile.
ACCENTURE_SEARCH_ROLES=
# 0 = Relevance / Vector Search (recommended for target roles), 1 = Newest
ACCENTURE_SORT_BY=0

# Naukri Collector (DISABLED - set to true to re-enable)
NAUKRI_ENABLED=false
NAUKRI_MAX_PAGES=1
NAUKRI_MAX_JOBS=10
NAUKRI_REQUEST_DELAY_SEC=2.0

# Lever Public Job Board (DISABLED - set to true to re-enable)
LEVER_ENABLED=false
LEVER_COMPANIES=paytm,meesho,jumpcloud,fampay,epifi
LEVER_MAX_JOBS_PER_COMPANY=25
LEVER_REQUEST_DELAY_SEC=1.0

# Greenhouse Public Job Board (DISABLED - set to true to re-enable)
GREENHOUSE_ENABLED=false
GREENHOUSE_COMPANIES=stripe,rubrik,mongodb,gitlab,elastic,instawork,glance,hackerrank,samsara,twilio
GREENHOUSE_MAX_JOBS_PER_COMPANY=25
GREENHOUSE_REQUEST_DELAY_SEC=1.0

# LinkedIn Source (DISABLED - job portal/channel)
LINKEDIN_ENABLED=false

